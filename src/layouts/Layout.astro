---
import "../styles/global.css";
const { title = "Clínica Comunitaria" } = Astro.props;
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
    </head>
    <body class="flex flex-col min-h-screen bg-slate-50 font-sans text-slate-700">
        <header class="bg-white border-b border-slate-200 shadow-sm p-4">
            <div class="max-w-7xl mx-auto flex justify-between items-center">
                <a
                    href="/"
                    class="flex items-center gap-2 text-xl font-bold text-slate-900"
                >
                    <span class="bg-teal-700 text-white rounded p-2 text-sm">
                        CC
                    </span>
                    Clínica Comunitaria
                </a>
                <nav class="hidden md:flex gap-6 font-medium text-slate-700">
                    <a href="/" class="hover:text-teal-700">
                        Inicio
                    </a>
                    <a href="/medicos" class="hover:text-teal-700">
                        Médicos
                    </a>
                    <a href="/contacto" class="hover:text-teal-700">
                        Contacto
                    </a>
                </nav>
                <div class="flex gap-3">
                    <a
                        href="/registro"
                        class="px-4 py-2 border border-teal-700 text-teal-700 rounded-md font-medium hover:bg-teal-50 transition"
                    >
                        Iniciar sesión
                    </a>
                    <a
                        href="/registro"
                        class="px-4 py-2 bg-teal-700 text-white rounded-md font-medium hover:bg-teal-800 transition"
                    >
                        Registrarse
                    </a>
                </div>
            </div>
        </header>

        <main class="flex-grow max-w-7xl mx-auto w-full p-4 sm:p-6 lg:p-8">
            <slot />
        </main>

        <footer class="bg-slate-900 text-white p-8 mt-auto">
            <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between gap-6">
                <address class="not-italic font-light">
                    <strong class="font-bold block mb-2">Contacto</strong>
                    (33) 0000 0000
                    <br />
                    contacto@clinicacomunitaria.mx
                    <br />
                    Tonalá, Jalisco
                </address>
                <nav class="flex flex-col font-light gap-2">
                    <strong class="font-bold">Legal</strong>
                    <a href="#" class="hover:text-teal-400">
                        Aviso de privacidad
                    </a>
                    <a href="#" class="hover:text-teal-400">
                        Términos y condiciones
                    </a>
                </nav>
            </div>
            <div class="max-w-7xl mx-auto text-center mt-8 pt-4 border-t border-slate-700 text-sm font-light text-slate-400">
                &copy; 2026 Clínica Comunitaria. Todos los derechos reservados.
            </div>
        </footer>
    </body>
</html>
