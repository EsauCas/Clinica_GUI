---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Paso 4: Confirmación - Clínica Comunitaria">
    <main class="max-w-5xl mx-auto">
        <h1 class="text-2xl font-bold text-slate-900 mb-6">
            Paso 4: Revisa y confirma tu cita
        </h1>

        <div class="grid md:grid-cols-3 gap-6">
            <div class="md:col-span-2 space-y-6">
                <article class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
                    <h2 class="text-lg font-bold text-slate-900 pb-2 border-b border-slate-100 mb-4">
                        Detalle de la cita
                    </h2>
                    <div class="grid grid-cols-2 gap-y-4">
                        <p class="text-slate-500 text-sm">Especialidad</p>
                        <p class="font-bold text-slate-900 text-right md:text-left">
                            Medicina General
                        </p>

                        <p class="text-slate-500 text-sm">Médico</p>
                        <p class="font-bold text-slate-900 text-right md:text-left">
                            Dr. Andrés Fuentes R.
                        </p>

                        <p class="text-slate-500 text-sm">Fecha y hora</p>
                        <p class="font-bold text-slate-900 text-right md:text-left">
                            Miércoles, 7 de octubre de 2026 - 10:00 AM
                        </p>
                    </div>
                </article>

                <fieldset class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
                    <h2 class="text-lg font-bold text-slate-900 pb-2 border-b border-slate-100 mb-4">
                        Datos adicionales
                    </h2>
                    <textarea
                        class="w-full border-slate-200 rounded-md focus:ring-teal-700 focus:border-teal-700 p-3"
                        rows="3"
                        placeholder="Motivo de la consulta (opcional)"
                    ></textarea>
                    <label class="flex items-center gap-2 mt-4 text-sm text-slate-600">
                        <input
                            type="checkbox"
                            checked
                            class="rounded text-teal-700 focus:ring-teal-700"
                        />
                        Recordatorio 24h antes por SMS
                    </label>
                </fieldset>
            </div>

            <aside class="md:col-span-1">
                <div class="bg-slate-900 p-6 rounded-xl shadow-sm text-center text-white mb-4">
                    <h2 class="text-sm font-bold tracking-widest text-slate-400 mb-4">
                        CITA A CONFIRMAR
                    </h2>
                    <p class="text-xl font-medium mb-1">Mié 7 Oct - 10:00 AM</p>
                    <p class="text-sm text-slate-300">Medicina General</p>
                    <p class="text-3xl font-bold text-orange-400 mt-6 mb-6">
                        $350 MXN
                    </p>
                    <a
                        href="/paciente/dashboard"
                        class="block w-full bg-teal-600 text-white py-3 rounded-lg font-bold hover:bg-teal-500 transition text-lg"
                    >
                        Confirmar cita
                    </a>
                </div>
                <div class="bg-green-50 border border-green-200 text-green-800 p-4 rounded-xl text-sm font-medium flex items-start gap-3">
                    <span>✅</span>
                    <p>
                        Al confirmar, te enviaremos los detalles al correo
                        registrado.
                    </p>
                </div>
            </aside>
        </div>
    </main>
</Layout>
